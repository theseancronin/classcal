# Postgres. Leave unset for local development and an in-process PGlite
# database is used instead (stored in .pglite/), so a clean checkout runs.
DATABASE_URL=

# Protects the sync endpoint so only the scheduler can trigger a fetch.
# Leave unset locally; set it in deployment.
CRON_SECRET=

# Web Push. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@classcal.ie

# Event interpretation. 'heuristic' (the default) needs no model and handles
# every event the school currently publishes. 'gemma' calls an
# OpenAI-compatible endpoint and falls back to the heuristic on any failure.
EVENT_INTERPRETER=heuristic
GEMMA_BASE_URL=
GEMMA_MODEL=gemma3:4b-it-qat
GEMMA_API_KEY=
